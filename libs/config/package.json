{
  "name": "@arthome-platform/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Environment reading, validated once at startup.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "@arthome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arthome/core": "https://github.com/jubasse/arthome-core/releases/download/v0.2.0-rc.2/arthome-core-0.2.0-rc.2.tgz",
    "@arthome/contracts": "https://github.com/jubasse/arthome-core/releases/download/v0.2.0-rc.2/arthome-contracts-0.2.0-rc.2.tgz",
    "zod": "4.6.5"
  }
}
