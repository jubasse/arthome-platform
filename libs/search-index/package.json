{
  "name": "@arthome-platform/search-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The search indices' names, mappings and document shapes, shared by the indexer that writes them and catalog that reads them.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "@arthome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arthome/core": "https://github.com/jubasse/arthome-core/releases/download/v0.1.0/arthome-core-0.1.0.tgz",
    "@opensearch-project/opensearch": "3.6.0"
  }
}
