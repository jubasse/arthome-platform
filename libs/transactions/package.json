{
  "name": "@arthome-platform/transactions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The transaction a CQRS command runs in: repositories bound to it, the domain events of what it wrote published once it has committed, and the deep freeze an aggregate holds its snapshot with.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "@arthome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@arthome/core": "https://github.com/jubasse/arthome-core/releases/download/v0.1.0/arthome-core-0.1.0.tgz"
  },
  "peerDependencies": {
    "@nestjs/cqrs": "^12.0.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/cqrs": "12.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  }
}
