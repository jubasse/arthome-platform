{
  "name": "@arthome-platform/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The integration harness: real Postgres, Kafka, OpenSearch and Redis in containers, and a service's feature modules over HTTP.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "@arthome/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:full": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
  "dependencies": {
    "@arthome-platform/config": "workspace:*",
    "@arthome-platform/messaging": "workspace:*",
    "@arthome/contracts": "https://github.com/jubasse/arthome-core/releases/download/v0.1.0/arthome-contracts-0.1.0.tgz",
    "@arthome/core": "https://github.com/jubasse/arthome-core/releases/download/v0.1.0/arthome-core-0.1.0.tgz",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kafkajs": "2.2.4",
    "pg": "8.23.0",
    "testcontainers": "12.1.0",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@nestjs/typeorm": "^12.0.1",
    "vitest": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@nestjs/typeorm": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vitest": "5.0.1"
  }
}
