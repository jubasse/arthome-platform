#!/bin/sh
# Two jobs, in this order: format what is staged, then refuse a red commit.
#
# §8.4 of code-conventions.md prescribes the first. The second is an addition,
# and it is here because of a fault that recurred THREE times: a compound shell
# command of the shape
#
#     pnpm run verify > log 2>&1; echo "EXIT=$?" && git commit …
#
# reads as though the commit were gated, and is not — `;` discards verify's
# status and `echo` always succeeds. Twice that pushed a red tree; the third time
# it committed one. Writing "chain with && never ;" in AGENTS.md did not prevent
# the third. A hook does, whatever the shell line happens to say.

set -e

# 1. Prettier on STAGED FILES ONLY, never the whole repository: a hook that
#    reformatted everything on every commit is what §8.4 exists to avoid, and
#    `md` is deliberately absent from the pattern (§3.7 — Prettier does not own
#    prose here).
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|mjs|json|html|css|scss)$' || true)
if [ -n "$files" ]; then
  echo "$files" | xargs pnpm exec prettier --write
  echo "$files" | xargs git add
fi

# 2. The gate, and needs no Docker — that is a property worth protecting, and
#    the reason the integration tests are named `*.itest.ts` and live behind
#    their own command.
#
#    Measured on 2026-09-29, develop at 89c8a25: cold (empty caches, fresh
#    worktree right after bootstrap) about 110-140 s; warm, unchanged, about
#    25-55 s; warm after a one-line change in one file, roughly 20-30 s above
#    that. A commit whose staged files are all `*.md` takes under 1 s (below).
#    See AGENTS.md's "Gates: three levels" for the three commands and the
#    full measurements.
#
#    `git commit --no-verify` skips this. That is git's design and not a hole
#      to plug: a hook is a reflex, not an authority. What it removes is the
#      accident.
#
#    A commit that touches only documentation (every staged file matching
#    `*.md`) cannot change what typecheck, lint or a test would report, so it
#    runs only the two checks that read prose — `check:symbols` and
#    `check:language` — instead of the full, cached `verify`. Both already
#    scan every tracked file, so the fast path is not a narrower check, only
#    a skip of the checks a doc change cannot affect.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
docs_only=true
for f in $staged; do
  case "$f" in
    *.md) ;;
    *) docs_only=false ;;
  esac
done

if [ "$docs_only" = true ] && [ -n "$staged" ]; then
  gate='pnpm run check:symbols && pnpm run check:language'
else
  gate='pnpm run verify'
fi

if ! eval "$gate"; then
  echo ''
  echo "pre-commit: \`$gate\` failed — nothing was committed."
  echo '  Fix it, or state why and use `git commit --no-verify` deliberately.'
  exit 1
fi
