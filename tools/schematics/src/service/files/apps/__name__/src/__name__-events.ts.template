import { outboxWriter, type OutboxWriter, type ServiceEvent } from '@arthome-platform/messaging';

/** The aggregate types <%= name %> publishes, each naming its topic `arthome.<type>` (events.md §3). */
type <%= pascal %>Topic = <%= topics.map((topic) => `'${name}.${topic.aggregate}'`).join(' | ') %>;

/**
 * The topic of every event <%= name %> publishes, named by its aggregate type. A caller names the
 *   type, never the topic. Empty until arthome-core's proto defines the service's events.
 */
export const <%= constant %>_EVENT_TOPICS = {} as const satisfies Record<string, <%= pascal %>Topic>;

export type <%= pascal %>EventType = keyof typeof <%= constant %>_EVENT_TOPICS;

export type <%= pascal %>Event = ServiceEvent<<%= pascal %>EventType>;

export const write<%= pascal %>Event: OutboxWriter<<%= pascal %>EventType> =
  outboxWriter(<%= constant %>_EVENT_TOPICS);
