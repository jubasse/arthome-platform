NODE_ENV=development
PORT=3003
CATALOG_URL=http://localhost:3002
IDENTITY_URL=http://localhost:3001
REDIS_URL=redis://localhost:56379
# Required in production, defaulted outside it: INTERNAL_TOKEN_SIGNING_KEY (a P-256 private JWK
# whose kid starts with bff-sf-), CSRF_SECRET, VIEWER_COUNTRY_HEADER (the gateway's geolocation
# header; unset outside production, every country is ZZ), TRUSTED_PROXIES (the gateway's addresses
# or subnets, or none when clients reach the BFF directly; unset outside production, none).
