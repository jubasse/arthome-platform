NODE_ENV=development
PORT=3005
DATABASE_URL=postgres://arthome:arthome@localhost:55432/streaming
# Required in production, defaulted outside it: JWKS_URL (the CDN's document, https),
# PLAYBACK_SIGNING_KEY (a P-256 private JWK whose kid starts with play-, never a development key)
# STREAM_KEY_SECRET (32 characters at least) and MEDIA_SERVER_SECRET (32 base64url characters
# at least, MediaMTX's HTTP Basic password, distinct from STREAM_KEY_SECRET).
# The media provider: `fake` (default) or `mediamtx`, both refused in production. With `mediamtx`,
# every URL below is required (compose.media.yaml's host ports; HANDOVER §0h). The stack itself
# reads MTX_AUTHHTTPADDRESS=http://mediamtx:<MEDIA_SERVER_SECRET>@host.docker.internal:3005/v1/media-server/authorize
STREAMING_MEDIA_PROVIDER=fake
MEDIAMTX_ORIGIN_API_URL=http://127.0.0.1:59997
MEDIAMTX_ORIGIN_METRICS_URL=http://127.0.0.1:59998
MEDIAMTX_ORIGIN_PLAYBACK_URL=http://127.0.0.1:59996
MEDIAMTX_ORIGIN_RTSP_URL=rtsp://mediamtx-origin:8554
MEDIAMTX_EDGE_API_URL=http://127.0.0.1:59995
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:58889
MEDIAMTX_SRT_URL=srt://127.0.0.1:58890
MEDIAMTX_MONITOR_HLS_URL=http://127.0.0.1:58887
MEDIAMTX_PLAYBACK_EDGE_URL=http://127.0.0.1:58888
