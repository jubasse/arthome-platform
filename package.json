{
  "name": "arthome-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Arthome microservices and their infrastructure.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "prettier": "@arthome/tooling/prettier",
  "scripts": {
    "postinstall": "arthome-sync-agent-docs",
    "pack:siblings": "node tools/pack-siblings.mjs",
    "bootstrap": "node tools/pack-siblings.mjs && pnpm install",
    "format": "prettier --write .",
    "fix": "prettier --write . && eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit && pnpm --filter \"./libs/*\" run typecheck",
    "test": "vitest run",
    "test:integration": "pnpm -r --if-present run test:integration",
    "check:versions": "arthome-check-versions",
    "check:tsconfig": "arthome-check-tsconfig",
    "check:enums": "arthome-check-enums",
    "check:language": "arthome-check-language",
    "check:symbols": "arthome-check-symbols",
    "check:prettier-conflict": "arthome-check-prettier-conflict",
    "verify:offline": "pnpm run check:vendor && pnpm run check:versions && pnpm run check:tsconfig && pnpm run check:enums && pnpm run check:language && pnpm run check:symbols",
    "verify": "pnpm run verify:offline && pnpm run check:prettier-conflict && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:vendor": "node tools/check-vendor-specs.mjs",
    "gen:events": "node tools/generate-events.mjs",
    "provision:topics": "node tools/provision-topics.mjs",
    "purge:retention": "node tools/purge-retention.mjs",
    "ops:check": "node tools/ops-check.mjs",
    "republish:outbox": "node tools/republish-outbox.mjs"
  },
  "devDependencies": {
    "@arthome-platform/config": "workspace:*",
    "@arthome-platform/messaging": "workspace:*",
    "@arthome/tooling": "file:./vendor/arthome-tooling-ff675b93cfe7.tgz",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^24",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "kafkajs": "2.2.4",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
